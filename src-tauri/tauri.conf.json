{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentinel Local",
  "version": "0.3.0",
  "identifier": "local.sentinel.securitycenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Sentinel Local",
      "width": 1440,
      "height": 900,
      "minWidth": 760,
      "minHeight": 640,
      "resizable": true,
      "fullscreen": false,
      "devtools": false
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main-capability"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
